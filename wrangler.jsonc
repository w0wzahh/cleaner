{
  // Assets-only Worker — no worker script, just serves docs/ statically.
  // docs/_headers is applied by the static-assets runtime automatically.
  "name": "cleaner",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./docs",
  },
  "routes": [
    { "pattern": "cleaner.w0wzahh.link", "custom_domain": true },
  ],
}
